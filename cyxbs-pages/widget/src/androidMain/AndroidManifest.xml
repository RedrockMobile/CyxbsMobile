<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Widget 详情只借用透明 Activity 承载弹窗，不得复用或拉起主应用任务栈。 -->
        <activity
            android:name=".widget.glance.CourseWidgetEntryActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity="${applicationId}.course_widget"
            android:theme="@style/CourseWidgetDialogTheme" />
        <receiver
            android:name=".widget.normal.NormalWidget"
            android:enabled="@bool/glance_appwidget_available"
            android:label="课程显示(大)"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.cyxbs.pages.widget.action.REFRESH" />
                <action android:name="flush" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_normal" />
        </receiver>

        <receiver
            android:name=".widget.single.SingleWidgetReceiver"
            android:enabled="@bool/glance_appwidget_available"
            android:label="当前课程"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.cyxbs.pages.widget.action.REFRESH" />
                <action android:name="flush" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_single" />
        </receiver>

        <receiver
            android:name=".widget.oversize.OversizedAppWidget"
            android:enabled="@bool/glance_appwidget_available"
            android:label="超大小部件"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.cyxbs.pages.widget.action.REFRESH" />
                <action android:name="flush" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_oversized_app_widget_info" />
        </receiver>

    </application>

</manifest>
